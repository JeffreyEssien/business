# Supabase development project: Project Connect dialog / Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only administrative actions. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Required application origin. Production must use HTTPS; missing or invalid
# configuration prevents payment and transactional-email links from being sent.
# Locally, match the port printed by npm run dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by a future explicit owner bootstrap, not automatic role assignment.
PLATFORM_OWNER_EMAIL=

# Optional for now: PostgreSQL connection string for migrations and RLS tests.
# Copy from Connect > Session pooler; replace password with URL-encoded DB password.
DATABASE_URL=

# Cloudinary media delivery. All three values are server configuration;
# never expose CLOUDINARY_API_SECRET through a NEXT_PUBLIC_ variable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack merchant payments. Use test keys outside production. The secret key
# stays server-only; this hosted-checkout flow does not expose it to the browser.
PAYSTACK_SECRET_KEY=

# Configure these endpoints in the Paystack dashboard for the deployed app:
# Callback: https://business-psi-umber.vercel.app/payments/paystack/callback
# Webhook:  https://business-psi-umber.vercel.app/api/webhooks/paystack

# Transactional email provider: `resend` (default) or `zeptomail`.
EMAIL_PROVIDER=resend

# ZeptoMail (Zoho). Token from Agents > SMTP/API > API Setup ("Send Mail token").
# Use your account's regional API host if it is not .com, e.g.
# https://api.zeptomail.eu/v1.1/email. The webhook secret is the Agent's
# webhook Authentication Key. Webhook URL: <app URL>/api/webhooks/zeptomail
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_WEBHOOK_SECRET=

# Resend transactional email. Start in disabled mode. For account-only testing,
# use `test`, onboarding@resend.dev, and the email address on the Resend account.
# Change to `live` only after EMAIL_FROM_ADDRESS belongs to a verified domain.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DELIVERY_MODE=disabled
EMAIL_FROM_NAME="Jeff from BusinessCare"
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_REPLY_TO=
EMAIL_TEST_RECIPIENT=

# Protects the bounded email delivery job endpoint. Use a long random value.
CRON_SECRET=
# Resend webhook: https://business-psi-umber.vercel.app/api/webhooks/resend
# Delivery job:   https://business-psi-umber.vercel.app/api/jobs/email-delivery

# Termii transactional SMS. The base URL is account-specific and appears beside
# the API key in Termii Settings > API token. Keep delivery disabled until the
# sender-ID workflow and one owner-observed test have completed.
TERMII_API_KEY=
TERMII_BASE_URL=
# Termii messaging delivery reports currently sign the untouched request body
# with HMAC-SHA512 in X-Termii-Signature.
TERMII_WEBHOOK_SECRET=
TERMII_SMS_CHANNEL=generic
SMS_DELIVERY_MODE=disabled
SMS_TEST_RECIPIENT=

# Termii webhook: https://business-psi-umber.vercel.app/api/webhooks/termii
# Delivery job:   https://business-psi-umber.vercel.app/api/jobs/sms-delivery

# Optional. Serves each store at {slug}.<domain> (for example businesscare.ng).
# Requires a wildcard DNS record and a wildcard domain on the host. Leave empty
# to keep stores only at /store/{slug}. Use "localhost" to test xelle.localhost:3001.
PLATFORM_ROOT_DOMAIN=
